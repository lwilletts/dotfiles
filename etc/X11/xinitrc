#!/bin/sh

DISPLAY=:1

xrandr --output DP-2 --primary --mode 2560x1440 -r 239.97 \
       --output DP-1 --off \
       --output HDMI-0 --off \
       --output HDMI-1 --off &> /dev/null

wmp -a 1280 720
xset s off -dpms
xsetroot -cursor_name left_ptr

[ -f ~/.Xresources ] && xrdb -load -I$HOME ~/.Xresources

hsetroot -cover "/home/fyr/usr/backs/black_waves.jpg"
xclock -d -face "lemon-8" -padding 8 -update 5 2> /dev/null &
sxhkd &

xset r rate 180 50

# event handler
wew | while read -r ev wid; do
    case $ev in
        CREATE)
            case $(atomx WM_CLASS $wid) in
                steam_app_*)
                    chwb -s 0 $wid
                    atomx GROUP=2 $wid
                    ;;
                xclock)
                    ignw -s $wid
                    chwb -s 2 -c 0xEEEEEE $wid
                    atomx GROUP=8 $wid
                    wmv 22 22 $wid
                    ;;
                urxvt)
                    wattr o $wid || {
                        chwb -s 0 $(pfw)
                        chwso -r $(pfw)
                        wtf $wid
                        wmv 22 60 $wid
                        atomx GROUP=1 $wid
                        chwb -s 2 -c 0xEEEEEE $wid
                    }
                    ;;
                *)
                    wattr o $wid || {
                        chwb -s 0 $(pfw)
                        chwso -r $(pfw)
                        wtf $wid
                        wmv -a 1280 720 $wid
                        chwb -s 2 -c 0xEEEEEE $wid
                    }
                    ;;
            esac
            ;;
        ENTER)
            wattr o $wid || {
                chwb -s 0 $(pfw)
                wtf $wid
                chwb -s 2 -c 0xEEEEEE $wid
            }
            ;;
        DESTROY)
            chwb -s 2 $(pfw)
            ;;
    esac
done