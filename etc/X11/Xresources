/* colours */
#include "/home/fyr/.d/etc/X11/colours/vapour"

/* basics */
*.modifier   : mod4
*.font       : xft:lemon-8
*.boldFont   : xft:lemon-8
*.italicFont : xft:lemon-8

/* general settings */
*.cursorBlink     : 0
*.cursorUnderline : 0
*.pointerBlank    : 0
*.urgentOnBell    : 1
*.visualBell      : 0
*.saveLines       : 16384

/* URxvt general settings */
URxvt.letterSpace    : 0
URxvt.internalBorder : 4
URxvt.externalBorder : 0
URxvt.scrollBar      : 0

/* URxvt transparency */
Urxvt.depth         : 32
URxvt.shading       : 50
URxvt.transparent   : false
URxvt.inheritPixmap : true