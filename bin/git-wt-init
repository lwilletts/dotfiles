#!/bin/sh
#
# git-wt-init
# convert the current repository into a bare repo plus worktrees:
#   repo/.bare            the git dir
#   repo/.git             file pointing at .bare
#   repo/<branch>/        one worktree per local branch
# the current checkout is moved into its worktree with untracked and ignored
# files kept. safe to rerun: an already converted repo only gets worktrees for
# branches that don't have one yet

set -eu

common=$(git rev-parse --path-format=absolute --git-common-dir) ||
    { echo "git-wt-init: not in a git repo" >&2; exit 1; }

if [ "$(git --git-dir="$common" config --bool core.bare)" = true ]; then
    root=$(dirname "$common")
    cd "$root"
else
    [ -d .git ] || { echo "git-wt-init: run from the root of a normal repo" >&2; exit 1; }
    [ -z "$(git status --porcelain)" ] || { echo "git-wt-init: commit or stash changes first" >&2; exit 1; }
    branch=$(git branch --show-current)
    [ -n "$branch" ] || { echo "git-wt-init: detached HEAD, check out a branch first" >&2; exit 1; }
    root=$PWD

    mkdir .wt-tmp
    for f in * .[!.]* ; do
        [ -e "$f" ] || continue
        case "$f" in .wt-tmp|.git) continue ;; esac
        mv "$f" .wt-tmp/
    done

    mv .git .bare
    git --git-dir=.bare config core.bare true
    echo "gitdir: ./.bare" > .git

    git worktree add --no-checkout "$branch" "$branch"
    for f in .wt-tmp/* .wt-tmp/.[!.]* ; do
        [ -e "$f" ] || continue
        mv "$f" "$branch"/
    done
    rmdir .wt-tmp
    git -C "$branch" reset -q
fi

checked_out=$(git worktree list --porcelain | sed -n 's|^branch refs/heads/||p')
git for-each-ref --format='%(refname:short)' refs/heads | while read -r b; do
    if printf '%s\n' "$checked_out" | grep -qxF -- "$b"; then
        continue
    fi
    if [ -e "$b" ]; then
        echo "git-wt-init: skipping $b, $root/$b already exists" >&2
        continue
    fi
    git worktree add -q "$b" "$b"
done

git worktree list
