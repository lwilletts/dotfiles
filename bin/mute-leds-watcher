#!/usr/bin/env bash
SPK=/sys/class/leds/platform::mute
MIC=/sys/class/leds/platform::micmute

# detach kernel triggers so we control the LEDs
echo none > $SPK/trigger 2>/dev/null
echo none > $MIC/trigger 2>/dev/null

update() {
  s=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')
  m=$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | awk '{print $2}')
  [[ $s == yes ]] && echo 1 > $SPK/brightness || echo 0 > $SPK/brightness
  [[ $m == yes ]] && echo 1 > $MIC/brightness || echo 0 > $MIC/brightness
}

update

pactl subscribe | while read -r line; do
  case $line in
    *"on sink"*|*"on source"*|*"on server"*) update ;;
  esac
done
