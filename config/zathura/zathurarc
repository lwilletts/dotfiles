# appearance
set font "Scientifica Medium 8"
set page-h-padding 10
set page-v-padding 10
set adjust-open width
set statusbar-v-padding 10
set statusbar-h-padding 20

# colours
set default-fg "#EFEFEF"
set default-bg "#101010"
set inputbar-fg "#EFEFEF"
set inputbar-bg "#101010"
set statusbar-fg "#EFEFEF"
set statusbar-bg "#101010"

set completion-fg "#EFEFEF"
set completion-bg "#101010"
set completion-group-fg "#A7A7A7"
set completion-group-bg "#101010"
set completion-highlight-fg "#101010"
set completion-highlight-bg "#EFEFEF"
set highlight-color "#A7A7A7"
set highlight-active-color "#B23450"

set notification-fg "#EFEFEF"
set notification-bg "#101010"
set notification-error-fg "#B23450"
set notification-error-bg "#101010"
set notification-warning-fg "#7086B3"
set notification-warning-bg "#101010"

set index-fg "#EFEFEF"
set index-bg "#101010"
set index-active-fg "#101010"
set index-active-bg "#EFEFEF"

set recolor true
set recolor-keephue true
set recolor-reverse-video false
set recolor-darkcolor "#EFEFEF"
set recolor-lightcolor "#101010"

# input
map i recolor
map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map <C-f> toggle_fullscreen

# titles
set statusbar-basename true
set window-title-basename true

# behaviour
set scroll-step 50
set scroll-page-aware true
set zoom-step 5
set guioptions "s"
set render-loading false
set abort-clear-search true
set selection-clipboard clipboard

# db
set database sqlite
