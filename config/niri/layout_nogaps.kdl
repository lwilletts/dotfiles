// nothing to do with layout really
// but having rounded corners work better here...
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

layout {
    gaps 0

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    // behaviour
    default-column-width { proportion 0.33; }
    center-focused-column "never"
    // always-center-single-column

    preset-column-widths {
        proportion 0.25
        proportion 0.33
        proportion 0.50
        proportion 0.67
    }

    preset-window-heights {
        proportion 0.25
        proportion 0.50
        proportion 0.67
        proportion 1.0
    }

    focus-ring {
        off
        width 2
    }

    border {
        on
        width 2
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        gap 0
        width 8
        gaps-between-tabs 0
        length total-proportion=1.0
        position "right"
        corner-radius 0
    }

    insert-hint {
        off
    }

    shadow {
        off
        softness 12
        spread 3
        offset x=2 y=2
        draw-behind-window false
    }
}
