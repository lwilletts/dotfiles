overview {
    zoom 0.75

    workspace-shadow {
        off
        softness 12
        spread 8
        offset x=0 y=0
    }
}

layout {
    background-color "transparent"
}

// make wallpaper layer be treated as backdrop
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

gestures {
    hot-corners {
        top-right
    }

    dnd-edge-view-scroll {
        trigger-width 100
        max-speed 500
    }

    dnd-edge-workspace-switch {
        trigger-height 100
        max-speed 500
    }
}

recent-windows {
    // off
    debounce-ms 500
    open-delay-ms 0

    highlight {
        active-color "#EFEFEFFF"
        urgent-color "#CA3448FF"
        padding 10
        corner-radius 4
    }

    previews {
        max-height 360
        max-scale 0.4
    }

    binds {
        Super+Tab       { next-window     scope="output"; }
        Super+Shift+Tab { previous-window scope="output"; }
    }
}
