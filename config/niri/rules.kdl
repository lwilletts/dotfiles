// assignment
workspace "☰" { open-on-output "eDP-1"; }
workspace "☱" { open-on-output "eDP-1"; }
workspace "☳" { open-on-output "eDP-1"; }
workspace "☶" { open-on-output "eDP-1"; }
workspace "☷" { open-on-output "eDP-1"; }

// general
window-rule {
    match app-id="foot"
    default-column-width { proportion 0.25; }
}

// dash
window-rule {
    match app-id=r#"qutebrowser|google-chrome"#
    open-on-workspace "☰"
    default-column-width { proportion 0.5; }
    open-focused false
}

window-rule {
    match app-id=r#"firefox"#
    open-on-workspace "☱"
    default-column-width { proportion 0.5; }
    open-focused false
}

window-rule {
    match app-id=r#"discord|Element|WebCord"#
    open-focused false
}

// game
window-rule {
    match app-id=r#"steam|Lutris|heroic"#
    open-on-workspace "☳"
    default-column-width { proportion 0.3; }
}

window-rule {
    match app-id=r#"steam_app_|gamescope"#
    open-on-workspace "☳"
    open-fullscreen true
}

window-rule {
    match app-id=r#"steam_app_1469060|steam_app_1231210|steam_app_824270|midair2|Stardew|Breach|overwatch.exe"#
    open-on-workspace "☳"
    open-maximized true
    variable-refresh-rate false
    min-width 1800
}

// content
window-rule {
    match app-id="com.obsproject" title=r#"^OBS$"#
    open-on-workspace "☳"
    open-maximized-to-edges true
    min-width 850
    min-height 400
}

window-rule {
    match app-id="com.obsproject"
    open-on-workspace "☶"
    open-focused true
    open-floating true
}

// floating windows
window-rule {
    match app-id=r#"mpv|FTL|swayimg"#
    open-floating true
}
