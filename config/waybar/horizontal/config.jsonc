// -*- mode: jsonc -*-
{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "width": 1800,
    "height": 28,
    "spacing": 4,
    "margin-bottom": 4,
    "clock": {
        "timezone": "Europe/London",
        "interval": 60,
        "format": "{:%H%M<span color='#808080'> hrs </span>%m/%d<span color='#808080'> %Y </span>}",
        "tooltip-format": "\n<span size='8pt' font='Cozette'>{calendar}</span>",
        "calendar": {
                    "mode"          : "month",
                    "mode-mon-col"  : 4,
                    "weeks-pos"     : "",
                    "on-scroll"     : -1,
                    "format": {
                              "months":     "<span color='#EFEFEF'>{}</span>",
                              "days":       "<span color='#EFEFEF'>{}</span>",
                              "weeks":      "<span color='#808080'>W{}</span>",
                              "weekdays":   "<span color='#808080'>{}</span>",
                              "today":      "<span color='#b23450'>{}</span>"
                              }
                    },
        "actions":  {
                    "on-click": "mode",
                    "on-scroll-up": "shift_up",
                    "on-scroll-down": "shift_down"
                    }
    },
    "niri/window": {
        "icon": true,
        "icon-size": 14,
        "format": "{title}",
        "separate-outputs": false
    },
    "niri/workspaces": {
        "current-only": false,
        "disable-click": false,
        "all-outputs": false,
        "format": "{name}"
    },
    "systemd-failed-units": {
        "hide-on-ok": true, 
        "format": "system: {nr_failed_system} user: {nr_failed_user}",
        "format-ok": "",
        "system": true,
        "user": true
    },
    "tray": {
	"show-passive-items": true,
	"reverse-direction": true,
        "icon-size": 16,
	"spacing": 2
    },
    "modules-left": [
        "clock",
        "niri/window"
    ],
    "modules-center": [
        "niri/workspaces"
    ],
    "modules-right": [
        "systemd-failed-units",
        "tray"
    ]
}
