// -*- mode: jsonc -*-
{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "left",
    "width": 40,
    "spacing": 0,
    "margin-top": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "margin-left": 0,

    "custom/launcher": {
        "format": "\n 🮰",
        "on-click": "fuzzel",
        "tooltip": false
    },

    "custom/files": {
        "format": "",
        "on-click": "foot",
        "tooltip": false
    },

    "custom/gap": {
        "format": " ",
        "tooltip": false
    },

    "niri/workspaces": {
        "format": "{name}",
        "current-only": false,
        "disable-click": false,
        "all-outputs": false
    },

    "wlr/taskbar": {
        "format": "{name}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "maximize",
        "icon-size": 14,
        "tooltip": true,
        "tooltip-format": "{title} | {app_id}",
        "sort-by-app-id": false,
        "active-first": false,
        "rewrite": {
            "qutebrowser": "",
            "Google Chrome": "",
            "Mozilla Firefox": "",
            "Foot": "",
            "discord": "🖃",
            "Element": "🖃",
            "Proton Pass": "",
            "Virtual Machine Manager": "󰒋",
            "OBS Studio": "󰐑",
            "mpv Media Player": "",
            "Swayimg": "",
            "GNU Image Manipulation Program": "",
            "WinBox": "",
            "BambuStudio": "💻",
            "OrcaSlicer": "💻",
            "Moonlight": "",
            "Remmina Remote Desktop Client": "",
            "Steam": "",
            "Heroic Games Launcher": "",
            ".*(steam_app_[0-9]+).*": "",
            ".*(exe).*": "",
            "Stardew Valley": "",
            "overwatch.exe": "",
            "Into The Breach": ""
        }
    },

    "network": {
        "inteval": 10,
        "family": "ipv4",
        "format": "",
        "format-wifi": "",
        "format-disabled": "",
        "format-disconnected": "",
        "tooltip": true,
        "tooltip-format": "{ifname}:\n\nip addr:\t{ipaddr}\ngateway:\t{gwaddr}",
        "tooltip-format-wifi": "{ifname}:\n\ngateway: {gwaddr}\nip addr: {ipaddr}\nsignal:\t {signalStrength}%",
        "tooltip-format-disabled": "Disabled",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "foot -e nmtui"
    },

    "battery": {
        "interval": 60,
        "bat": "BAT0",
        "full-at": 100,
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{icon}",
        "format-icons": [ "", "", "", "", "" ],
        "format-time": "{H}hrs {M}mins",
        "tooltip": true,
        "tooltip-format": "{timeTo}\n\npower:\t  {power}W draw\nhealth:\t  {health}%\ncapacity: {capacity}%",

        "events": {
            "on-discharging-critical": "notify-send -u critical 'Low Battery!'"
        }
    },

    "tray": {
        "show-passive-items": true,
        "reverse-direction": true,
        "icon-size": 12,
        "spacing": 6
    },

    "clock": {
        "timezone": "Europe/London",
        "interval": 60,
        "format": "{:%H%M<span color='#808080'>\n hrs</span>}",
        "tooltip-format": "\n<span size='8pt' font='lemon'>{calendar}</span>",
        "calendar": {
            "mode"          : "year",
            "mode-mon-col"  : 4,
            "weeks-pos"     : "",
            "on-scroll"     : -1,
            "format": {
                "months":     "<span color='#D9EAE2'>{}</span>",
                "days":       "<span color='#D9EAE2'>{}</span>",
                "weeks":      "<span color='#808080'>W{}</span>",
                "weekdays":   "<span color='#808080'>{}</span>",
                "today":      "<span color='#B23450'>{}</span>"
            }
        },
        "actions": {
            "on-click": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "modules-left": [
        "custom/launcher",
        "niri/workspaces"
    ],

    "modules-center": [
        "wlr/taskbar"
    ],

    "modules-right": [
        "network",
        "battery",
        "tray",
        "clock"
    ]
}

// "format": "⏻", // power
// "format": "◱", // overview bottom left or another waybar on the right side
// "format": "" // writer / text editor icon
//  excel / calc
