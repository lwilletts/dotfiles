# basic
mod1 + Return
    urxvt
mod1 + d
    dmenu_run -fn "Cozette-8" -b -f -i -p "Run >" -nb "#1C1C1C" -nf "#EEEEEE" -sb "#EEEEEE" -sf "#1C1C1C"
mod1 + q
    killw -p $(pfw)

# window focus
mod1 + Tab
    chwb -s 0 $(pfw); \ 
    wid=$(lsw | head -n 1); \
    wtf $wid; chwso -r $(pfw); chwb -s 2 -c 0xEEEEEE $wid
mod1 + {h,j,k,l}
    { dir=x; sort=-nr;, dir=y; sort=-n;, dir=y; sort=-nr;, dir=x; sort=-n; } \
    if pfw &> /dev/null; then wid=$(lsw | xargs wattr "$dir"i | sort "$sort" | sed "0,/$(pfw)/d" | sed "1s/^[0-9]* //p;d"); fi; \
    if [ ! -z $wid ]; then \
        chwb -s 0 $(pfw); wtf $wid; chwso -r $wid; chwb -s 2 -c 0xEEEEEE $wid; \
    fi 

# window manipulation
mod1 + {a,m}
    if [ ! -z "$(atomx WM_POSITION $(pfw))" ]; then \
        wtp $(atomx WM_POSITION $(pfw)); \
        atomx -d WM_POSITION $(pfw); \
        wmp -a $(($(wattr x $(pfw)) + $(wattr w $(pfw)) / 2)) $(($(wattr y $(pfw)) + $(wattr h $(pfw)) / 2)); \
    else \
        atomx WM_POSITION="$(wattr xywhi $(pfw))" $(pfw) > /dev/null; \
        { x=$(wattr x $(pfw)); w=$(wattr w $(pfw));, x=$(($(wattr x $(lsw -r)) + 20)); w=$(($(wattr w $(lsw -r)) - 40)); } \
        y=$(($(wattr y $(lsw -r)) + 20)); \
        h=$(($(wattr h $(lsw -r)) - 40)); \
        wtp $x $y $w $h $(pfw); \
    fi
mod1 + f
    if [ ! -z "$(atomx WM_POSITION $(pfw))" ]; then \
        wtp $(atomx WM_POSITION $(pfw)); \
        atomx -d WM_POSITION $(pfw); \
        chwb -s 2 -c 0xEEEEEE $(pfw); \
        wmp -a $(($(wattr x $(pfw)) + $(wattr w $(pfw)) / 2)) $(($(wattr y $(pfw)) + $(wattr h $(pfw)) / 2)); \
    else \
        atomx WM_POSITION="$(wattr xywhi $(pfw))" $(pfw) > /dev/null; \
        chwb -s 0 $(pfw); \
        wtp $(wattr xywh $(lsw -r)) $(pfw); \
    fi

# window move
mod1 + shift + {h,j,k,l}
    wmv {-40 0,0 40,0 -40,40 0} $(pfw); \
    wmp -a $(($(wattr x $(pfw)) + $(wattr w $(pfw)) / 2)) $(($(wattr y $(pfw)) + $(wattr h $(pfw)) / 2))
mod1 + g
    x=$(($(wattr w $(lsw -r)) / 2)); y=$(($(wattr h $(lsw -r)) / 2)); \
    wmv -a $x $y $(pfw); wmp -a $x $y

# window resize
mod1 + {minus, equal, shift + minus, plus}
    wrs {-40 0,40 0,0 -40,0 40} $(pfw)

# groups
mod1 + {Escape,1,2,3,4,5,6,7,8}
    for wid in $(lsw -a); do \
        if [ $(atomx GROUP $wid) -eq {0,1,2,3,4,5,6,7,8} 2>/dev/null ]; then \
            mapw -t $wid; chwb -s 0 $wid; chwso -r $wid; \
        fi; \
    done
mod1 + shift + {1,2,3,4,5,6,7,8}
    atomx GROUP={1,2,3,4,5,6,7,8} $(pfw) > /dev/null && mapw -u $(pfw)
mod1 + c
    atomx -d GROUP $(pfw)

# mouse ctrl
mod1 + {@button1,@button3}
    wattr o $(pfw) || chwso -r $(pfw); {xmmv,xmrs}
mod1 + button4
    for wid in $(lsw -u); do \
        if [ $(atomx GROUP $wid) -eq 0 2>/dev/null ]; then \
            mapw -m $wid; chwb -s 0 $wid; chwso -r $wid; \
        fi; \
    done
mod1 + button5
    atomx GROUP=0 $(pfw) > /dev/null && mapw -u $(pfw)

# sys
mod1 + shift + r
    pkill -USR1 -x sxhkd
mod1 + BackSpace
    sudo chvt 1
mod1 + ctrl + BackSpace
    pkill xinit

# shot
Print
    xscreenshot $(lsw -r) | ff2png > $HOME/$(date +%s).png
shift + Print
    xscreenshot $(pfw) | ff2png > $HOME/$(date +%s).png
mod4 + shift + s
    file=$HOME/$(date +%s).png; \
    xscreenshot $(lsw -r) | ff2png > $file; \
    magick $file -crop $(xrectsel '%wx%h+%x+%y') $file
